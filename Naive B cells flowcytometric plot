# ============================================================
# Naive B Cells: Box-and-Whisker Plot with Individual Dots
# ============================================================

# Install packages once if needed:
# install.packages(c("ggplot2", "dplyr"))

library(ggplot2)
library(dplyr)

# ------------------------------------------------------------
# 1. Embed all sample-level data
# ------------------------------------------------------------

naive_b_cells <- data.frame(
  Group = factor(
    c(
      rep("GBS", 24),
      rep("MS", 23),
      rep("SLE", 23),
      rep("HC", 24)
    ),
    levels = c("GBS", "MS", "SLE", "HC")
  ),
  Value = c(
    # GBS
    57.9, 48.2, 57.9, 75.8, 73.0, 73.4,
    49.3, 80.5, 76.7, 79.9, 75.6, 59.7,
    80.3, 45.0, 80.1, 71.7, 64.3, 75.5,
    88.1, 75.8, 54.0, 65.3, 80.6, 71.7,
    
    # MS
    76.4, 25.1, 56.5, 49.3, 78.9, 72.2,
    74.0, 57.8, 7.29, 59.8, 71.5, 71.3,
    22.8, 69.7, 72.9, 64.7, 74.4, 60.6,
    72.1, 83.0, 77.5, 68.4, 50.6,
    
    # SLE
    42.8, 42.4, 53.0, 56.0, 31.3, 55.8,
    28.3, 56.3, 68.2, 21.8, 31.0, 40.4,
    26.9, 55.1, 71.3, 11.3, 32.9, 54.6,
    31.6, 80.7, 69.5, 71.2, 91.1,
    
    # HC
    67.6, 75.1, 61.1, 79.2, 77.8, 55.6,
    70.5, 36.5, 75.8, 73.0, 65.8, 87.3,
    68.3, 59.4, 52.7, 73.6, 47.5, 84.9,
    74.0, 83.8, 60.8, 56.8, 59.5, 68.0
  )
)

# Optional validation
print(table(naive_b_cells$Group))
print(summary(naive_b_cells))

# ------------------------------------------------------------
# 2. Define colors
# ------------------------------------------------------------

group_colors <- c(
  "GBS" = "#4C78A8",  # blue
  "MS"  = "#F28E2B",  # orange
  "SLE" = "#E15759",  # red
  "HC"  = "#59A14F"   # green/teal
)

# ------------------------------------------------------------
# 3. Define significance brackets
#    Dunn post-hoc comparisons with Holm adjustment
# ------------------------------------------------------------

brackets <- data.frame(
  xmin = c(1, 3),
  xmax = c(3, 4),
  y = c(98, 108),
  label = c(
    "p = 0.00078",
    "p = 0.007"
  )
)

# Convert bracket information into line segments
bracket_segments <- rbind(
  data.frame(
    x = brackets$xmin,
    xend = brackets$xmax,
    y = brackets$y,
    yend = brackets$y
  ),
  data.frame(
    x = brackets$xmin,
    xend = brackets$xmin,
    y = brackets$y,
    yend = brackets$y - 2
  ),
  data.frame(
    x = brackets$xmax,
    xend = brackets$xmax,
    y = brackets$y,
    yend = brackets$y - 2
  )
)

# ------------------------------------------------------------
# 4. Create the plot
# ------------------------------------------------------------

set.seed(123)  # Reproducible dot jitter

p <- ggplot(naive_b_cells, aes(x = Group, y = Value, fill = Group)) +
  
  # Box-and-whisker plot
  geom_boxplot(
    width = 0.58,
    alpha = 0.65,
    outlier.shape = NA,
    color = "black",
    linewidth = 0.7
  ) +
  
  # Individual sample dots
  geom_jitter(
    aes(color = Group),
    width = 0.13,
    height = 0,
    size = 2.7,
    alpha = 0.90,
    show.legend = FALSE
  ) +
  
  # Significance brackets
  geom_segment(
    data = bracket_segments,
    aes(
      x = x,
      xend = xend,
      y = y,
      yend = yend
    ),
    inherit.aes = FALSE,
    color = "black",
    linewidth = 0.55
  ) +
  
  # Significance labels
  geom_text(
    data = brackets,
    aes(
      x = (xmin + xmax) / 2,
      y = y + 2.2,
      label = label
    ),
    inherit.aes = FALSE,
    size = 3.5,
    fontface = "plain"
  ) +
  
  # Colors
  scale_fill_manual(values = group_colors) +
  scale_color_manual(values = group_colors) +
  
  # Axes
  scale_y_continuous(
    name = "% of Naive B cells",
    limits = c(0, 115),
    breaks = seq(0, 100, by = 25),
    expand = expansion(mult = c(0.01, 0.02))
  ) +
  
  scale_x_discrete(name = "Group") +
  
  # Labels
  labs(
    title = "Naive B Cells",
    subtitle = "Box-and-whisker plot with individual samples",
    caption = "Dots represent individual samples"
  ) +
  
  # Theme
  theme_classic(base_size = 13) +
  theme(
    plot.title = element_text(
      face = "bold",
      hjust = 0.5,
      size = 16
    ),
    plot.subtitle = element_text(
      hjust = 0.5,
      size = 11
    ),
    axis.title.x = element_text(
      face = "bold",
      margin = margin(t = 10)
    ),
    axis.title.y = element_text(
      face = "bold",
      margin = margin(r = 10)
    ),
    axis.text = element_text(
      color = "black"
    ),
    axis.line = element_line(
      color = "black",
      linewidth = 0.7
    ),
    axis.ticks = element_line(
      color = "black",
      linewidth = 0.6
    ),
    legend.position = "none",
    plot.caption = element_text(
      hjust = 0,
      face = "italic",
      size = 9
    ),
    plot.margin = margin(
      t = 15,
      r = 15,
      b = 15,
      l = 15
    )
  )

# Display plot
print(p)

# ------------------------------------------------------------
# 5. Save high-resolution image
# ------------------------------------------------------------

ggsave(
  filename = "naive_b_cells_boxplot.png",
  plot = p,
  width = 7,
  height = 6,
  units = "in",
  dpi = 600,
  bg = "white"
)
