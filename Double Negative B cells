  ),
  
  stringsAsFactors = FALSE
)

# Set group order
data$Group <- factor(
  data$Group,
  levels = c("GBS", "MS", "SLE", "HC")
)

# Holm-adjusted Dunn post-hoc P values
p_values <- data.frame(
  group1 = c("GBS", "GBS", "GBS", "MS", "MS", "SLE"),
  group2 = c("MS", "SLE", "HC", "SLE", "HC", "HC"),
  p_adj = c(1.0000, 0.0040, 1.0000, 0.0061, 1.0000, 0.0061),
  y.position = c(95, 105, 115, 125, 135, 145)
)

# P-value labels
p_values$p_label <- paste0(
  "P = ",
  format.pval(
    p_values$p_adj,
    digits = 3,
    eps = 0.0001
  )
)

# Group colors
group_colors <- c(
  "GBS" = "#4C78A8",
  "MS"  = "#F58518",
  "SLE" = "#E45756",
  "HC"  = "#72B7B2"
)

point_colors <- c(
  "GBS" = "#1F4E79",
  "MS"  = "#B85C00",
  "SLE" = "#9E2F2F",
  "HC"  = "#2F7F7B"
)

# Box plot with all pairwise comparisons
ggplot(data, aes(x = Group, y = Value, fill = Group)) +
  
  geom_boxplot(
    width = 0.6,
    alpha = 0.65,
    outlier.shape = NA
  ) +
  
  geom_jitter(
    aes(color = Group),
    width = 0.15,
    size = 2.5,
    alpha = 0.85
  ) +
  
  stat_pvalue_manual(
    p_values,
    label = "p_label",
    xmin = "group1",
    xmax = "group2",
    y.position = "y.position",
    tip.length = 0.01,
    bracket.size = 0.5,
    size = 3.5,
    fontface = "bold",
    inherit.aes = FALSE
  ) +
  
  labs(
    title = "Double Negative B Cells",
    x = "Group",
    y = "% of DN B cells (of Total B cells)"
  ) +
  
  scale_fill_manual(values = group_colors) +
  scale_color_manual(values = point_colors) +
  
  coord_cartesian(
    ylim = c(0, 155),
    clip = "off"
  ) +
  
  theme_classic(base_size = 13) +
  
  theme(
    legend.position = "none",
    plot.title = element_text(
      face = "bold",
      hjust = 0.5
    ),
    axis.title = element_text(face = "bold"),
    plot.margin = margin(10, 10, 30, 10)
  )

