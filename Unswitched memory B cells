# ------------------------------------------------------------
# 2. Validate embedded data
# ------------------------------------------------------------

print(table(unswitched_memory_b_cells$Group))
print(unswitched_memory_b_cells)

# ------------------------------------------------------------
# 3. Define group colors
# ------------------------------------------------------------

group_colors <- c(
  "GBS" = "#4C78A8",
  "MS"  = "#F28E2B",
  "SLE" = "#E15759",
  "HC"  = "#59A14F"
)

# ------------------------------------------------------------
# 4. Define significant comparisons
#
# Worksheet-reported Holm-adjusted p-values:
# GBS vs MS = 0.0211
# MS vs SLE = 0.0207
# ------------------------------------------------------------

brackets <- data.frame(
  xmin = c(1, 2),
  xmax = c(2, 3),
  y = c(8.8, 10.2),
  label = c(
    "p = 0.0211",
    "p = 0.0207"
  )
)

# Bracket line segments
bracket_segments <- rbind(
  # Horizontal lines
  data.frame(
    x = brackets$xmin,
    xend = brackets$xmax,
    y = brackets$y,
    yend = brackets$y
  ),
  
  # Left vertical ticks
  data.frame(
    x = brackets$xmin,
    xend = brackets$xmin,
    y = brackets$y,
    yend = brackets$y - 0.25
  ),
  
  # Right vertical ticks
  data.frame(
    x = brackets$xmax,
    xend = brackets$xmax,
    y = brackets$y,
    yend = brackets$y - 0.25
  )
)

# ------------------------------------------------------------
# 5. Create box-and-whisker plot
# ------------------------------------------------------------

set.seed(123)

p <- ggplot(
  unswitched_memory_b_cells,
  aes(x = Group, y = Value, fill = Group)
) +
  
  # Box-and-whisker plot
  geom_boxplot(
    width = 0.58,
    alpha = 0.65,
    outlier.shape = NA,
    color = "black",
    linewidth = 0.7
  ) +
  
  # Individual sample dots
  geom_jitter(
    aes(color = Group),
    width = 0.13,
    height = 0,
    size = 2.8,
    alpha = 0.90,
    show.legend = FALSE
  ) +
  
  # Significance brackets
  geom_segment(
    data = bracket_segments,
    aes(
      x = x,
      xend = xend,
      y = y,
      yend = yend
    ),
    inherit.aes = FALSE,
    color = "black",
    linewidth = 0.55
  ) +
  
  # Significance labels
  geom_text(
    data = brackets,
    aes(
      x = (xmin + xmax) / 2,
      y = y + 0.25,
      label = label
    ),
    inherit.aes = FALSE,
    size = 3.5
  ) +
  
  # Group colors
  scale_fill_manual(values = group_colors) +
  scale_color_manual(values = group_colors) +
  
  # Axis formatting
  scale_y_continuous(
    name = "% of unswitched memory B cells (of Total B cells)",
    limits = c(0, 13),
    breaks = seq(0, 12, by = 2),
    expand = expansion(mult = c(0.01, 0.02))
  ) +
  
  scale_x_discrete(
    name = "Group"
  ) +
  
  # Titles
  labs(
    title = "Unswitched Memory B Cells",
    subtitle = "Box-and-whisker plot with individual samples",
    caption = "Dots represent individual samples"
  ) +
  
  # Publication-style theme
  theme_classic(base_size = 13) +
  theme(
    plot.title = element_text(
      face = "bold",
      hjust = 0.5,
      size = 16
    ),
    plot.subtitle = element_text(
      hjust = 0.5,
      size = 11
    ),
    axis.title.x = element_text(
      face = "bold",
      margin = margin(t = 10)
    ),
    axis.title.y = element_text(
      face = "bold",
      margin = margin(r = 10)
    ),
    axis.text = element_text(
      color = "black"
    ),
    axis.line = element_line(
      color = "black",
      linewidth = 0.7
    ),
    axis.ticks = element_line(
      color = "black",
      linewidth = 0.6
    ),
    legend.position = "none",
    plot.caption = element_text(
      hjust = 0,
      face = "italic",
      size = 9
    ),
    plot.margin = margin(
      t = 15,
      r = 15,
      b = 15,
      l = 15
    )
  )

# Display the plot
print(p)

